# Copy to .env and adjust. Every setting is optional in development.
DOCAUTH_ENV=development                 # "production" enforces DOCAUTH_SECRET_KEY
# DOCAUTH_SECRET_KEY=change-me-to-a-long-random-string
# DOCAUTH_DATA_DIR=./data               # uploads, results, sqlite db, datasets
# DOCAUTH_DATABASE_URL=sqlite:///./data/docauth.db   # or postgresql+psycopg://...
DOCAUTH_ADMIN_EMAIL=admin@example.com   # bootstrapped on first start if no admin exists
DOCAUTH_ADMIN_PASSWORD=change-me-please1
# DOCAUTH_ALLOW_REGISTRATION=true
# DOCAUTH_COOKIE_SECURE=true            # set when serving over HTTPS
# DOCAUTH_CORS_ORIGINS=http://localhost:5173
# DOCAUTH_MAX_UPLOAD_MB=25
# DOCAUTH_MAX_PDF_PAGES=10
# DOCAUTH_ANALYSIS_WORKERS=2
# DOCAUTH_WEIGHTS_DIR=                  # override location of the ONNX models
